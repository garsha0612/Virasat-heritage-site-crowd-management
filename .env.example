# ===================================================
# HERITAGE SITE CROWD MANAGEMENT SYSTEM
# ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/heritageDB?retryWrites=true&w=majority

# JWT Authentication Secret (Minimum 32 characters)
JWT_SECRET=heritage_secret_key_jwt_authentication_token_2026_super_secure

# AWS S3 Cloud Storage (Phase 10)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIA_PLACEHOLDER_KEY
AWS_SECRET_ACCESS_KEY=PLACEHOLDER_SECRET_KEY
AWS_S3_BUCKET_NAME=heritage-site-media

# Crowd Telemetry Simulation Mode (true = Algorithmic Simulator)
NEXT_PUBLIC_ENABLE_SIMULATED_CROWD=true
