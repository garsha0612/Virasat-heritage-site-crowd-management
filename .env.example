# ===================================================
# ANVAYA – WHERE HERITAGE CONNECTS GENERATIONS
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ===================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# MongoDB Connection URI (ACID Multi-Document Transactions Require a Replica Set)
# -----------------------------------------------------------------------------
# PRODUCTION (MongoDB Atlas - Built-in Replica Set & Transactions):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/heritageDB?retryWrites=true&w=majority
#
# LOCAL DEVELOPMENT (Single-Node Replica Set):
# Start mongod with replica set enabled:
# mongod --port 27018 --dbpath ./data/db --replSet rs0 --bind_ip 127.0.0.1
# In mongo shell: rs.initiate({ _id: "rs0", members: [{ _id: 0, host: "127.0.0.1:27018" }] })
MONGODB_URI=mongodb://127.0.0.1:27018/heritageDB?replicaSet=rs0

# JWT Authentication Secret (Minimum 32 characters, keep secret)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# AWS S3 Cloud Storage (Phase 10 Placeholder)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=heritage-site-media

# Demonstration Crowd & Telemetry Flag (true = Algorithmic Simulator Mode)
NEXT_PUBLIC_ENABLE_SIMULATED_CROWD=true

# -----------------------------------------------------------------------------
# Cashfree Payment Gateway - SANDBOX ONLY (Test Environment)
# -----------------------------------------------------------------------------
# ⚠️  CRITICAL: These are TEST credentials for SANDBOX environment ONLY
# ⚠️  NEVER use production/live credentials in this application
# ⚠️  All payments are simulated - no real money transactions
# 
# Get your sandbox credentials from: https://merchant.cashfree.com/merchants/test
# Documentation: https://docs.cashfree.com/docs
# Test Cards: https://docs.cashfree.com/docs/api-reference/payments/data-to-test-integration
#
# Sandbox Test Credentials:
CASHFREE_CLIENT_ID=your_cashfree_test_client_id
CASHFREE_CLIENT_SECRET=your_cashfree_test_client_secret
CASHFREE_ENV=SANDBOX
CASHFREE_API_VERSION=2025-01-01
#
# Webhook Secret (Optional - for signature verification)
# Get from: Dashboard > Developers > Webhooks > Your Endpoint > Signing Secret
CASHFREE_WEBHOOK_SECRET=your_webhook_signing_secret_here
